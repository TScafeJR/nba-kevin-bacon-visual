{
  "name": "nba-kevin-bacon-visual",
  "version": "0.0.1",
  "private": true,
  "description": "This is a package for visualizing the nba players",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "audit": "yarn npm audit --all --recursive --severity moderate",
    "build": "vite build",
    "api": "node server/index.ts",
    "api:dev": "node --watch server/index.ts",
    "build-storybook": "storybook build",
    "data": "node scripts/build-player-data.ts",
    "dev": "vite",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6007",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc && tsc -p tsconfig.node.json"
  },
  "author": "Tyrone Scafe",
  "license": "ISC",
  "dependencies": {
    "express": "5.3.0",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vis-network": "10.1.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/addon-mcp": "10.6.4",
    "@storybook/addon-vitest": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "oxlint": "1.90.0",
    "playwright": "1.64.1",
    "storybook": "10.6.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
